"""
DeepEval RAG Değerlendirme - .env Şablon Dosyası

API key'lerinizi bu dosyaya ekleyin ve dosya adını .env olarak değiştirin.
Güvenlik için .env dosyasını .gitignore'a eklemeyi unutmayın!
"""

# Confident AI API Key (Opsiyonel - sonuçları görselleştirmek için)
# https://app.confident-ai.com/ adresinden alabilirsiniz
CONFIDENT_API_KEY=your_confident_api_key_here

# OpenRouter API Key (Ücretsiz tier kullanmak için)
# https://openrouter.ai/keys adresinden alabilirsiniz
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hugging Face API Token (Ücretsiz inference API için)
# https://huggingface.co/settings/tokens adresinden alabilirsiniz
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Ollama için herhangi bir API key gerekmez (yerel çalışır)
